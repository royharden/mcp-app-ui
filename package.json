{
  "name": "mcp-approval-desk",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "S17 MCP Approval Desk: an MCP App with an interactive approval UI, a Bridge Lab inspection host, a headless harness and a UI-versus-text comparison. Synthetic data, record-only decisions.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:view": "vite build --config vite.view.config.ts && node --experimental-strip-types scripts/embed-view.ts",
    "build:lab": "vite build --config vite.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "build": "npm run build:view && npm run build:lab && npm run build:server",
    "dev": "npm run build:view && vite --config vite.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:stdio": "vitest run --config vitest.stdio.config.ts",
    "test:e2e": "echo \"Browser checks are pending: see tests/e2e/README.md\" && exit 1",
    "measure:replay": "node --experimental-strip-types measure/replay.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.0.1",
    "@modelcontextprotocol/sdk": "1.25.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "happy-dom": "17.1.0",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "3.0.5"
  }
}
