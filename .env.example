# Public project coordinates only. These identify the project; they do not sign a user in.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server secrets. Set them in Bolt server settings. Never prefix these with VITE_.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://your-app.bolt.host

# Local stdio process only. This is an injected actor id, not authentication.
# CONFIRM_ACTOR_ID=
